<Window x:Class="BrightEyes.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrightEyes"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:viewModels="clr-namespace:BrightEyes.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:r="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        mc:Ignorable="d"
        Title="BrightEyes" Height="780" Width="1280" MinHeight="620" MinWidth="980"
        Background="#F2F5F7">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <r:Ribbon x:Name="MainRibbon" Grid.Row="0">
            <r:RibbonTab Header="{DynamicResource ResourceKey=Ribbon_Tab_File}">
                <r:RibbonGroup Header="文档">
                    <r:RibbonButton Label="打开" LargeImageSource="/BrightEyes;component/Resources/open.png" Command="{Binding OpenImageCommand}" />
                    <r:RibbonButton Label="保存过程" LargeImageSource="/BrightEyes;component/Resources/save.png" Command="{Binding SavePipelineCommand}" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="编辑">
                    <r:RibbonButton Label="撤销" SmallImageSource="/BrightEyes;component/Resources/BackwardArrow.png" Command="{Binding UndoCommand}" />
                    <r:RibbonButton Label="重做" SmallImageSource="/BrightEyes;component/Resources/ForwardArrow.png" Command="{Binding RedoCommand}" />
                </r:RibbonGroup>
            </r:RibbonTab>

            <r:RibbonTab Header="{DynamicResource ResourceKey=Ribbon_Tab_View}">
                <r:RibbonGroup Header="显示终端">
                    <TextBlock Text="{Binding DisplayColorSummary}" Width="300" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8" />
                </r:RibbonGroup>
            </r:RibbonTab>
        </r:Ribbon>

        <Border Grid.Row="1" Background="#E5EBF0" BorderBrush="#C5D1DA" BorderThickness="0,0,0,1">
            <Grid Margin="7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="文档" VerticalAlignment="Center" Foreground="#526675" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                          DisplayMemberPath="Title" Margin="7,4,12,4" />
                <TextBlock Grid.Column="2" Text="{Binding ActiveDocument.Source.FilePath}" VerticalAlignment="Center"
                           Foreground="#526675" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="190" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="350" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="检查器" Margin="5">
                <TabControl>
                    <TabItem Header="来源">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding MetadataFacts}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <Border Grid.Row="1" BorderBrush="#D8E1E8" BorderThickness="0,1,0,0" Padding="5,7">
                                <TextBlock Text="{Binding InspectorText}" TextWrapping="Wrap" FontSize="10" Foreground="#526675" />
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="分析">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ActiveOscilloscopes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#A5C9E6" BorderThickness="1" CornerRadius="3" Margin="3,4" Padding="5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#526675" TextWrapping="Wrap" />
                                                <Image Height="120" Margin="0,5,0,0" Stretch="Fill"
                                                       Source="{Binding LatestAnalysis, Converter={StaticResource AnalysisDataToBitmapConverter}}" />
                                                <TextBlock Text="{Binding Diagnostic}" FontSize="9" Foreground="#526675" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCD7DF" />

            <Border Grid.Column="2" Margin="0,5" Background="#F9FAFE" BorderBrush="#A5C9E6" BorderThickness="1" CornerRadius="2">
                <local:D3DHost InitializeAction="{Binding InitializeRendererAction}" ResizeAction="{Binding ResizeRendererAction}">
                    <wf:Panel />
                </local:D3DHost>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#CCD7DF" />

            <Grid Grid.Column="4" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="过程">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="拖动过程或 Ribbon 项；橙色仅为非阻塞语义警告" Margin="5,2,5,5"
                                   FontSize="10" Foreground="#526675" TextWrapping="Wrap" />
                        <ListBox x:Name="PipelineList" Grid.Row="1" ItemsSource="{Binding ActiveDocument.Processes}"
                                 SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ProcessListItemStyle}"
                                 Background="Transparent" BorderThickness="0" AllowDrop="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="PipelineList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PipelineList_PreviewMouseMove"
                                 DragOver="PipelineList_DragOver" DragLeave="PipelineList_DragLeave" Drop="PipelineList_Drop" />
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#CCD7DF" />

                <GroupBox Grid.Row="2" Header="过程调整">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="5,2,5,6">
                            <TextBlock Text="{Binding SelectedProcessName}" FontWeight="SemiBold" Foreground="#172B3A" />
                            <TextBlock Text="{Binding SelectedProcessDescription}" FontSize="10" Foreground="#526675" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedProcess.Diagnostic}" Margin="0,3,0,0" FontSize="10" Foreground="#526675" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SelectedBasicParameters}" />
                                <Expander Header="高级输入解释与输出声明" Margin="3,6,3,3" IsExpanded="False">
                                    <ItemsControl ItemsSource="{Binding SelectedAdvancedParameters}" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#E3E8EE" BorderBrush="#C5D1DA" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#334B5C" />
                <TextBlock Grid.Column="1" Text="GPU 优先 / linear scRGB / 1.0 = 80 nit" VerticalAlignment="Center" Foreground="#526675" />
            </Grid>
        </Border>
    </Grid>
</Window>
