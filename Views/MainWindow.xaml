<Window x:Class="BrightEyes.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrightEyes"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:viewModels="clr-namespace:BrightEyes.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:r="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="1" RadiusY="0.8">
            <GradientStop Color="#D0E0FF" Offset="0"/>
            <GradientStop Color="White" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        
        <!-- Top Ribbon Area -->
        <r:Ribbon Grid.Row="0">
            <!-- 文件 -->
            <r:RibbonTab Header="{DynamicResource ResourceKey=Ribbon_Tab_File}">
                <r:RibbonGroup Header="文件">
                    <r:RibbonButton Label="新建" LargeImageSource="/BrightEyes;component/Resources/NewNodeGraph.png" />
                    <r:RibbonButton Label="打开" LargeImageSource="/BrightEyes;component/Resources/open.png" />
                    <r:RibbonButton Label="保存" LargeImageSource="/BrightEyes;component/Resources/save.png" />
                    <r:RibbonButton Label="另存为" LargeImageSource="/BrightEyes;component/Resources/export.png" />
                    <r:RibbonButton Label="关闭" LargeImageSource="/BrightEyes;component/Resources/CrossMark.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="导入/导出">
                    <r:RibbonButton Label="导入图像" LargeImageSource="/BrightEyes;component/Resources/load.png" />
                    <r:RibbonButton Label="导入文件夹" LargeImageSource="/BrightEyes;component/Resources/WorkFolder.png" />
                    <r:RibbonButton Label="导出图像" LargeImageSource="/BrightEyes;component/Resources/export.png" />
                    <r:RibbonButton Label="导出序列" LargeImageSource="/BrightEyes;component/Resources/ExportImage.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="批处理">
                    <r:RibbonButton Label="批量转换" LargeImageSource="/BrightEyes;component/Resources/BatchProcess.png" />
                    <r:RibbonButton Label="批量重命名" LargeImageSource="/BrightEyes;component/Resources/Refresh.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="首选项">
                    <r:RibbonButton Label="设置" LargeImageSource="/BrightEyes;component/Resources/Setup.png" />
                    <r:RibbonButton Label="键位" LargeImageSource="/BrightEyes;component/Resources/Script.png" />
                    <r:RibbonButton Label="关于" LargeImageSource="/BrightEyes;component/Resources/GuideBot.png" />
                </r:RibbonGroup>
            </r:RibbonTab>
            <!-- 视图 -->
            <r:RibbonTab Header="{DynamicResource ResourceKey=Ribbon_Tab_View}">
                <r:RibbonGroup Header="缩放">
                    <r:RibbonButton Label="放大" LargeImageSource="/BrightEyes;component/Resources/zoom_in.png" />
                    <r:RibbonButton Label="缩小" LargeImageSource="/BrightEyes;component/Resources/zoom_out.png" />
                    <r:RibbonButton Label="适合窗口" LargeImageSource="/BrightEyes;component/Resources/zoom_fit.png" />
                    <r:RibbonButton Label="100%" LargeImageSource="/BrightEyes;component/Resources/imgpp.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="方向">
                    <r:RibbonButton Label="左旋90°" LargeImageSource="/BrightEyes;component/Resources/BackwardArrow.png" />
                    <r:RibbonButton Label="右旋90°" LargeImageSource="/BrightEyes;component/Resources/ForwardArrow.png" />
                    <r:RibbonButton Label="水平翻转" LargeImageSource="/BrightEyes;component/Resources/BackwardArrowAlt.png" />
                    <r:RibbonButton Label="垂直翻转" LargeImageSource="/BrightEyes;component/Resources/ForwardArrowAlt.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="显示">
                    <r:RibbonCheckBox Label="显示网格" />
                    <r:RibbonCheckBox Label="显示标尺" />
                    <r:RibbonCheckBox Label="显示直方图叠加" />
                    <r:RibbonButton Label="全屏" LargeImageSource="/BrightEyes;component/Resources/HDRDisplay.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="视图模式">
                    <r:RibbonButton Label="单张" LargeImageSource="/BrightEyes;component/Resources/image.png" />
                    <r:RibbonButton Label="并排对比" LargeImageSource="/BrightEyes;component/Resources/imagealt.png" />
                    <r:RibbonButton Label="滑块对比" LargeImageSource="/BrightEyes;component/Resources/imagealt.png" />
                </r:RibbonGroup>
            </r:RibbonTab>
            <!-- 分析 -->
            <r:RibbonTab Header="{DynamicResource ResourceKey=Ribbon_Tab_Analysis}">
                <r:RibbonGroup Header="示波器">
                    <r:RibbonButton Label="直方图" LargeImageSource="/BrightEyes;component/Resources/ResourcesLibrary.png" />
                    <r:RibbonButton Label="波形图" LargeImageSource="/BrightEyes;component/Resources/Nodegraph.png" />
                    <r:RibbonButton Label="矢量示波" LargeImageSource="/BrightEyes;component/Resources/ColorManager.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="颜色">
                    <r:RibbonButton Label="拾色器" LargeImageSource="/BrightEyes;component/Resources/RawImage.png" />
                    <r:RibbonButton Label="白平衡" LargeImageSource="/BrightEyes;component/Resources/GreenLight.png" />
                    <r:RibbonButton Label="色域覆盖" LargeImageSource="/BrightEyes;component/Resources/aurora.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="度量">
                    <r:RibbonButton Label="像素检查" LargeImageSource="/BrightEyes;component/Resources/CheckMark.png" />
                    <r:RibbonButton Label="距离测量" LargeImageSource="/BrightEyes;component/Resources/ForwardArrow.png" />
                    <r:RibbonButton Label="角度测量" LargeImageSource="/BrightEyes;component/Resources/ForwardArrowAlt.png" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="HDR">
                    <r:RibbonButton Label="启用色调映射" LargeImageSource="/BrightEyes;component/Resources/HDRDisplay.png" />
                    <r:RibbonButton Label="显示HDR元数据" LargeImageSource="/BrightEyes;component/Resources/ResourcesLibrary.png" />
                </r:RibbonGroup>
            </r:RibbonTab>
        </r:Ribbon>

        <!-- Main Content Area (Three Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- Left Oscilloscope Area -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5,0,5,5">
                <Border Height="120" Margin="0,5,0,5" Background="White" CornerRadius="3">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="5"/>
                    </Border.Effect>
                    <TextBlock Text="示波器 1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="120" Margin="0,5,0,5" Background="White" CornerRadius="3">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="5"/>
                    </Border.Effect>
                    <TextBlock Text="示波器 2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="120" Margin="0,5,0,5" Background="White" CornerRadius="3">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="5"/>
                    </Border.Effect>
                    <TextBlock Text="示波器 3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Center Rendering Area -->
            <local:D3DHost Grid.Column="1" InitializeAction="{Binding InitializeRendererAction}"
                           ResizeAction="{Binding ResizeRendererAction}">
                <wf:Panel />
            </local:D3DHost>

            <!-- Right Process Area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="过程" Margin="5,5,5,5" Background="White">
                    <GroupBox.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="5"/>
                    </GroupBox.Effect>
                    <TextBlock Text="线性的图像处理功能列表" TextWrapping="Wrap" Margin="5" />
                </GroupBox>
                <GroupBox Grid.Row="1" Header="过程调整" Margin="5,0,5,5" Background="White">
                    <GroupBox.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="5"/>
                    </GroupBox.Effect>
                    <TextBlock Text="用于调整每个过程的处理内容" TextWrapping="Wrap" Margin="5" />
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Bottom Reserved Area -->
        <Border Grid.Row="2" Background="#FFE3E8EE" />
    </Grid>
</Window>
