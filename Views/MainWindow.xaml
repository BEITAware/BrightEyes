<Window x:Class="BrightEyes.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrightEyes"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:viewModels="clr-namespace:BrightEyes.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:r="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
        mc:Ignorable="d"
        Title="BrightEyes" Height="780" Width="1280" MinHeight="620" MinWidth="980"
        Background="{DynamicResource WindowSurfaceBrush}" AllowDrop="True"
        PreviewDragOver="PipelineDragOver" PreviewDrop="PipelineDrop"
        GiveFeedback="PipelineDragGiveFeedback">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <r:Ribbon x:Name="MainRibbon" Grid.Row="0">
            <r:RibbonTab Header="{DynamicResource ResourceKey=Ribbon_Tab_File}">
                <r:RibbonGroup Header="文档">
                    <r:RibbonButton Label="打开" LargeImageSource="/BrightEyes;component/Resources/open.png" Command="{Binding OpenImageCommand}" />
                    <r:RibbonButton Label="保存过程" LargeImageSource="/BrightEyes;component/Resources/save.png" Command="{Binding SavePipelineCommand}" />
                </r:RibbonGroup>
                <r:RibbonGroup Header="编辑">
                    <r:RibbonButton Label="撤销" SmallImageSource="/BrightEyes;component/Resources/BackwardArrow.png" Command="{Binding UndoCommand}" />
                    <r:RibbonButton Label="重做" SmallImageSource="/BrightEyes;component/Resources/ForwardArrow.png" Command="{Binding RedoCommand}" />
                </r:RibbonGroup>
            </r:RibbonTab>

            <r:RibbonTab Header="{DynamicResource ResourceKey=Ribbon_Tab_View}">
                <r:RibbonGroup Header="缩放">
                    <r:RibbonButton Label="重置缩放" LargeImageSource="/BrightEyes;component/Resources/zoom_fit.png"
                                    Command="{Binding ResetZoomCommand}"
                                    ToolTip="使图像重新适合当前预览区域。" />
                    <r:RibbonButton Label="放大" SmallImageSource="/BrightEyes;component/Resources/zoom_in.png"
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip="以预览区域中心为基准放大图像。" />
                    <r:RibbonButton Label="缩小" SmallImageSource="/BrightEyes;component/Resources/zoom_out.png"
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip="以预览区域中心为基准缩小图像。" />
                </r:RibbonGroup>
            </r:RibbonTab>

            <r:RibbonTab Header="主题测试">
                <r:RibbonGroup Header="主题">
                    <r:RibbonButton Label="Bureau Blue" Tag="Bureau Blue" Click="ThemeButton_Click" />
                    <r:RibbonButton Label="Bureau White" Tag="Bureau White" Click="ThemeButton_Click" />
                    <r:RibbonButton Label="Luna" Tag="Luna" Click="ThemeButton_Click" />
                    <r:RibbonButton Label="Polar Day" Tag="Polar Day" Click="ThemeButton_Click" />
                    <r:RibbonButton Label="Polar Night" Tag="Polar Night" Click="ThemeButton_Click" />
                    <r:RibbonButton Label="High Contrast" Tag="High Contrast" Click="ThemeButton_Click" />
                </r:RibbonGroup>
            </r:RibbonTab>
        </r:Ribbon>

        <Border Grid.Row="1" Background="{DynamicResource DocumentBarBackgroundBrush}"
                BorderBrush="{DynamicResource ApplicationChromeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="文档" VerticalAlignment="Center" Foreground="{DynamicResource ApplicationMutedTextBrush}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                          DisplayMemberPath="Title" Margin="7,4,12,4" />
                <TextBlock Grid.Column="2" Text="{Binding ActiveDocument.Source.FilePath}" VerticalAlignment="Center"
                           Foreground="{DynamicResource ApplicationMutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="190" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="400" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="检查器" Margin="5">
                <TabControl>
                    <TabItem Header="来源">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding MetadataFacts}" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <Border Grid.Row="1" BorderBrush="{DynamicResource InspectorDividerBrush}" BorderThickness="0,1,0,0" Padding="5,7">
                                <TextBlock Text="{Binding InspectorText}" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource ApplicationMutedTextBrush}" />
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="分析">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <TextBlock Text="没有活动的分析过程" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ApplicationMutedTextBrush}" FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=AnalysisProcessList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl x:Name="AnalysisProcessList" ItemsSource="{Binding ActiveAnalysisProcesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource AnalysisBorderBrush}" BorderThickness="1" CornerRadius="2"
                                                    Background="{DynamicResource PipelineSurfaceBrush}" Margin="3,4" SnapsToDevicePixels="True"
                                                    ToolTip="{Binding Diagnostic}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="22" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{DynamicResource BureauHeaderBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BureauHeaderBorderBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource BureauHeaderTextureBrush}" IsHitTestVisible="False" />
                                                            <TextBlock Text="{Binding Descriptor.Definition.NameResourceKey, Converter={StaticResource ResourceLookupConverter}}"
                                                                       Margin="7,0,5,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BureauHeaderTextBrush}" />
                                                            <Border Grid.Column="1" BorderBrush="{DynamicResource BureauHeaderSeparatorBrush}" BorderThickness="1,0,0,0">
                                                                <TextBlock Text="{Binding State}" Margin="6,0" VerticalAlignment="Center" FontSize="9"
                                                                           Foreground="{DynamicResource ApplicationMutedTextBrush}" />
                                                            </Border>
                                                            <Border Grid.ColumnSpan="2" Margin="1" BorderBrush="{DynamicResource HighlightEdgeBrush}"
                                                                    BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="1" Margin="5" BorderBrush="{DynamicResource BureauHeaderBorderBrush}"
                                                            BorderThickness="1" Background="#141C22" SnapsToDevicePixels="True">
                                                        <Image Height="{Binding PlotHeight}" Stretch="Fill" SnapsToDevicePixels="True"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               Source="{Binding LatestAnalysis, Converter={StaticResource AnalysisDataToBitmapConverter}}">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsStrictHistogram}" Value="True">
                                                                            <Setter Property="Width" Value="112" />
                                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Border>
                                                    <Border Grid.Row="2" Background="{DynamicResource BureauStatusBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BureauHeaderSeparatorBrush}" BorderThickness="0,1,0,0">
                                                        <TextBlock Text="{Binding Summary}" Margin="6,0" VerticalAlignment="Center" FontSize="9"
                                                                   Foreground="{DynamicResource ApplicationMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource WorkspaceSplitterBrush}" />

            <Border Grid.Column="2" Margin="0,5" Background="{DynamicResource PreviewSurfaceBrush}"
                    BorderBrush="{DynamicResource AnalysisBorderBrush}" BorderThickness="1" CornerRadius="2">
                <local:D3DHost InitializeAction="{Binding InitializeRendererAction}"
                               ResizeAction="{Binding ResizeRendererAction}"
                               MouseWheelAction="{Binding PreviewMouseWheelAction}">
                    <wf:Panel />
                </local:D3DHost>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource WorkspaceSplitterBrush}" />

            <Grid Grid.Column="4" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="210" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" MinHeight="160" />
                </Grid.RowDefinitions>

                <GroupBox x:Name="PipelineGroup" Grid.Row="0" Header="过程">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="23" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource BureauHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BureauHeaderBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <!-- Keep a permanent scrollbar gutter so the table header and
                                         the item status column share the same right-hand origin. -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.ColumnSpan="4" Fill="{DynamicResource BureauHeaderTextureBrush}"
                                           IsHitTestVisible="False" />
                                <Border BorderBrush="{DynamicResource BureauHeaderSeparatorBrush}" BorderThickness="0,0,1,0">
                                    <TextBlock Text="#" Margin="6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BureauHeaderTextBrush}" FontSize="10" />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BureauHeaderSeparatorBrush}" BorderThickness="0,0,1,0">
                                    <TextBlock Text="过程 / 数据流" Margin="6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BureauHeaderTextBrush}" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="状态" Margin="6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BureauHeaderTextBrush}" FontWeight="SemiBold" />
                                <Border Grid.Column="3"
                                        Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}"
                                        BorderBrush="{DynamicResource BureauHeaderSeparatorBrush}"
                                        BorderThickness="1,0,0,0" IsHitTestVisible="False" />
                                <Border Grid.ColumnSpan="4" Margin="1" BorderBrush="{DynamicResource HighlightEdgeBrush}"
                                        BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Border x:Name="PipelineDropSurface" Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PipelineSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PipelineSurfaceBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1,0,1,0" />
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value="DropAllowed">
                                            <Setter Property="Background" Value="{DynamicResource ProcessDropAreaAllowedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PipelineAllowedBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="Tag" Value="DropDenied">
                                            <Setter Property="Background" Value="{DynamicResource PipelineDeniedSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PipelineDeniedBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="Tag" Value="DropWarning">
                                            <Setter Property="Background" Value="{DynamicResource ProcessDropAreaWarningBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PipelineWarningBorderBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock Text="拖放到此区域" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PipelinePlaceholderTextBrush}" FontSize="12" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=PipelineList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox x:Name="PipelineList" ItemsSource="{Binding ActiveDocument.Processes}"
                                         SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                         ItemContainerStyle="{DynamicResource ProcessListItemStyle}"
                                         ItemTemplate="{DynamicResource ProcessItemTemplate}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         PreviewMouseLeftButtonDown="PipelineList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="PipelineList_PreviewMouseMove" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Background="{DynamicResource BureauStatusBackgroundBrush}"
                                BorderBrush="{DynamicResource PipelineStatusBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid Margin="5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PipelineHint" Text="就绪" VerticalAlignment="Center"
                                           FontSize="10" Foreground="{DynamicResource PipelineStatusTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveDocument.Processes.Count, StringFormat=共 {0} 项}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10"
                                           Foreground="{DynamicResource PipelineStatusTextBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource WorkspaceSplitterBrush}" />

                <GroupBox Grid.Row="2" Header="过程调整">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="5,2,5,6">
                            <TextBlock Text="{Binding SelectedProcessName}" FontWeight="SemiBold" Foreground="{DynamicResource ApplicationPrimaryTextBrush}" />
                            <TextBlock Text="{Binding SelectedProcessDescription}" FontSize="10" Foreground="{DynamicResource ApplicationMutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedProcess.Diagnostic}" Margin="0,3,0,0" FontSize="10"
                                       Foreground="{DynamicResource ApplicationMutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SelectedBasicParameters}" />
                                <Expander Header="高级输入解释与输出声明" Margin="3,6,3,3" IsExpanded="False">
                                    <ItemsControl ItemsSource="{Binding SelectedAdvancedParameters}" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource ApplicationChromeBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource StatusBarTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ViewZoomText}" Margin="12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusBarTextBrush}" />
                <TextBlock Grid.Column="2" Text="GPU 优先 / linear scRGB / 1.0 = 80 nit" VerticalAlignment="Center"
                           Foreground="{DynamicResource ApplicationMutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
