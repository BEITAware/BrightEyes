<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:contracts="clr-namespace:BrightEyes.Processing.Contracts"
                    xmlns:viewModels="clr-namespace:BrightEyes.ViewModels"
                    xmlns:converters="clr-namespace:BrightEyes.Converters">

    <converters:ResourceLookupConverter x:Key="ResourceLookupConverter" />
    <converters:AnalysisDataToBitmapConverter x:Key="AnalysisDataToBitmapConverter" />

    <SolidColorBrush x:Key="ProcessSurfaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ProcessSelectedBrush" Color="#E7F1FA" />
    <SolidColorBrush x:Key="ProcessBorderBrush" Color="#A5C9E6" />
    <SolidColorBrush x:Key="ProcessDisabledBrush" Color="#E7E9EC" />
    <SolidColorBrush x:Key="ProcessTextBrush" Color="#172B3A" />
    <SolidColorBrush x:Key="ProcessMutedTextBrush" Color="#526675" />
    <SolidColorBrush x:Key="RawConnectionBrush" Color="#22AFC7" />
    <SolidColorBrush x:Key="IntermediateConnectionBrush" Color="#7C69C7" />
    <SolidColorBrush x:Key="WarningConnectionBrush" Color="#D97818" />
    <SolidColorBrush x:Key="ErrorConnectionBrush" Color="#C43E4B" />

    <BitmapImage x:Key="ProcessIcon.Image" UriSource="/BrightEyes;component/Resources/image.png" />
    <BitmapImage x:Key="ProcessIcon.Decoder" UriSource="/BrightEyes;component/Resources/load.png" />
    <BitmapImage x:Key="ProcessIcon.Mapper" UriSource="/BrightEyes;component/Resources/ColorManager.png" />
    <BitmapImage x:Key="ProcessIcon.View" UriSource="/BrightEyes;component/Resources/HDRDisplay.png" />
    <BitmapImage x:Key="ProcessIcon.Scope" UriSource="/BrightEyes;component/Resources/Nodegraph.png" />
    <BitmapImage x:Key="ProcessIcon.Utility" UriSource="/BrightEyes;component/Resources/FlexiblePort.png" />

    <Style TargetType="{x:Type ListBoxItem}" x:Key="ProcessListItemStyle">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="InsertionPlaceholder" Background="Transparent" Padding="0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="DropTarget">
                            <Setter TargetName="InsertionPlaceholder" Property="Padding" Value="0,14,0,0" />
                            <Setter TargetName="InsertionPlaceholder" Property="Background" Value="{StaticResource IntermediateConnectionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type contracts:IImageProcess}">
        <Grid Margin="5,0" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="22" ToolTip="{Binding IncomingConnectionMessage}">
                <Border x:Name="ConnectionGlow" Width="86" Height="12" CornerRadius="4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource IntermediateConnectionBrush}" Opacity="0.75">
                    <Border.Effect>
                        <DropShadowEffect Color="#7C69C7" BlurRadius="13" ShadowDepth="0" Opacity="0.8" />
                    </Border.Effect>
                </Border>
                <Border x:Name="WarningOverlay" Height="4" Width="58" CornerRadius="2"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Background="{StaticResource WarningConnectionBrush}" Visibility="Collapsed" />
                <TextBlock Text="{Binding IncomingConnectionLabel}" FontSize="9" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="ProcessBlock" Grid.Row="1" MinHeight="78" Padding="10,8" CornerRadius="3"
                    Background="{StaticResource ProcessSurfaceBrush}" BorderBrush="{StaticResource ProcessBorderBrush}"
                    BorderThickness="1" ToolTip="{Binding Diagnostic}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除" Command="{Binding PlacementTarget.Tag.DeleteProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="启用/禁用" Command="{Binding PlacementTarget.Tag.ToggleProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="重置参数" Command="{Binding PlacementTarget.Tag.ResetProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="恢复自动值" Command="{Binding PlacementTarget.Tag.RestoreAutomaticCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="查看输入元数据" Command="{Binding PlacementTarget.Tag.InspectInputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="查看输出元数据" Command="{Binding PlacementTarget.Tag.InspectOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="复制参数" Command="{Binding PlacementTarget.Tag.CopyParametersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="粘贴参数" Command="{Binding PlacementTarget.Tag.PasteParametersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="28" Height="28" VerticalAlignment="Top"
                           Source="{Binding Descriptor.Definition.IconResourceKey, Converter={StaticResource ResourceLookupConverter}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Descriptor.Definition.NameResourceKey, Converter={StaticResource ResourceLookupConverter}}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ProcessTextBrush}" />
                        <TextBlock Text="{Binding Summary}" Margin="0,3,4,0" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{StaticResource ProcessMutedTextBrush}" />
                        <TextBlock Text="{Binding Descriptor.Definition.InputType, StringFormat=输入 {0}}" Margin="0,4,0,0"
                                   FontSize="10" Foreground="{StaticResource ProcessMutedTextBrush}" />
                        <TextBlock Text="{Binding Descriptor.Definition.OutputType, StringFormat=输出 {0}}"
                                   FontSize="10" Foreground="{StaticResource ProcessMutedTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Border x:Name="StateBadge" Padding="5,2" CornerRadius="2" Background="#DCE8F2">
                            <TextBlock Text="{Binding State}" FontSize="9" Foreground="{StaticResource ProcessTextBrush}" />
                        </Border>
                        <TextBlock x:Name="OverrideBadge" Text="手动" Margin="0,5,0,0" HorizontalAlignment="Center"
                                   FontSize="9" Foreground="#9A4E08" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Descriptor.Definition.InputType}" Value="RawImage">
                <Setter TargetName="ConnectionGlow" Property="Background" Value="{StaticResource RawConnectionBrush}" />
                <Setter TargetName="ConnectionGlow" Property="Effect">
                    <Setter.Value><DropShadowEffect Color="#22AFC7" BlurRadius="13" ShadowDepth="0" Opacity="0.8" /></Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IncomingConnectionSeverity}" Value="None">
                <Setter TargetName="ConnectionGlow" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IncomingConnectionSeverity}" Value="SemanticWarning">
                <Setter TargetName="WarningOverlay" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IncomingConnectionSeverity}" Value="HardError">
                <Setter TargetName="ConnectionGlow" Property="Background" Value="{StaticResource ErrorConnectionBrush}" />
                <Setter TargetName="ProcessBlock" Property="BorderBrush" Value="{StaticResource ErrorConnectionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasUserOverrides}" Value="True">
                <Setter TargetName="OverrideBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="ProcessBlock" Property="Background" Value="{StaticResource ProcessDisabledBrush}" />
                <Setter TargetName="ProcessBlock" Property="Opacity" Value="0.68" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="ProcessBlock" Property="Background" Value="{StaticResource ProcessSelectedBrush}" />
                <Setter TargetName="ProcessBlock" Property="BorderBrush" Value="#2B79B8" />
                <Setter TargetName="ProcessBlock" Property="BorderThickness" Value="2" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="NumberParameterTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}"
                    IsSnapToTickEnabled="False" Value="{Binding NumberValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="EnumParameterTemplate">
        <ComboBox ItemsSource="{Binding EnumValues}" SelectedItem="{Binding SelectedEnumValue, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="BooleanParameterTemplate">
        <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}" Content="启用" />
    </DataTemplate>

    <DataTemplate x:Key="TextParameterTemplate">
        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:ProcessParameterViewModel}">
        <Border BorderBrush="#D8E1E8" BorderThickness="0,0,0,1" Padding="3,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource ProcessTextBrush}" TextWrapping="Wrap" />
                    <CheckBox Grid.Column="1" Content="自动" Margin="8,0,0,0" IsChecked="{Binding IsAutomatic, Mode=TwoWay}" />
                </Grid>
                <ContentControl x:Name="Editor" Content="{Binding}" Margin="0,6,0,0" ContentTemplate="{StaticResource TextParameterTemplate}" />
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="检测" FontSize="10" Foreground="{StaticResource ProcessMutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding DetectedText}" FontSize="10" Margin="8,0,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="自动" FontSize="10" Foreground="{StaticResource ProcessMutedTextBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AutomaticText}" FontSize="10" Margin="8,0,0,0" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{Binding AutomaticSource, StringFormat=来源：{0}}" FontSize="10" Foreground="{StaticResource ProcessMutedTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ValidationError}" FontSize="10" Foreground="{StaticResource ErrorConnectionBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Editor}" Value="Number">
                <Setter TargetName="Editor" Property="ContentTemplate" Value="{StaticResource NumberParameterTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Editor}" Value="Enum">
                <Setter TargetName="Editor" Property="ContentTemplate" Value="{StaticResource EnumParameterTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Editor}" Value="Boolean">
                <Setter TargetName="Editor" Property="ContentTemplate" Value="{StaticResource BooleanParameterTemplate}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type contracts:MetadataFact}">
        <Grid Margin="3,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource ProcessMutedTextBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{Binding Source, StringFormat={}{0}}" TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource ProcessMutedTextBrush}" />
                <TextBlock Text="{Binding Conflict}" TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource WarningConnectionBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
