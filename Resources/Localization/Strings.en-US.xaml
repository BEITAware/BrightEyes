    <system:String x:Key="Process_ImageSource_Name">Image</system:String>
    <system:String x:Key="Process_ImageSource_Description">Compressed file, container, and immutable source metadata.</system:String>
    <system:String x:Key="Process_Decoder_Name">Decoder</system:String>
    <system:String x:Key="Process_Decoder_Description">Interprets image bytes and creates a GPU source; normalization may fuse with its first consumer.</system:String>
    <system:String x:Key="Process_ViewRendering_Name">View rendering</system:String>
    <system:String x:Key="Process_ViewRendering_Description">Maps a linear extended-sRGB intermediate into view space, then encodes and presents it.</system:String>
    <system:String x:Key="Process_GaussianBlur_Name">Gaussian blur</system:String>
    <system:String x:Key="Process_GaussianBlur_Description">Runs a separable GPU Gaussian convolution and produces an independent RGBA16F linear intermediate texture.</system:String>
    <system:String x:Key="Process_Waveform_Name">Waveform</system:String>
    <system:String x:Key="Process_Waveform_Description">Plots horizontal signal distribution as luminance, RGB parade, or RGB overlay with linear amplitude.</system:String>
    <system:String x:Key="Process_Histogram_Name">Histogram</system:String>
    <system:String x:Key="Process_Histogram_Description">Plots the luminance or a single color-channel distribution with optional logarithmic amplitude.</system:String>
    <system:String x:Key="Process_Vectorscope_Name">Vectorscope</system:String>
    <system:String x:Key="Process_Vectorscope_Description">Plots chroma distribution using hue colors with optional logarithmic radius.</system:String>
    <system:String x:Key="Process_StrictHistogram_Name">Strict histogram</system:String>
    <system:String x:Key="Process_StrictHistogram_Description">Uses a tall 256-row plot where every luminance address maps to exactly one raster row, with optional logarithmic amplitude.</system:String>
