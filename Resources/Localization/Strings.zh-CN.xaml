<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Ribbon_Tab_File">文件</system:String>
    <system:String x:Key="Ribbon_Tab_View">视图</system:String>
    <system:String x:Key="Ribbon_Tab_Analysis">分析</system:String>

    <system:String x:Key="ProcessGroup_Input">输入与解码</system:String>
    <system:String x:Key="ProcessGroup_Color">色彩与映射</system:String>
    <system:String x:Key="ProcessGroup_Filter">滤镜</system:String>
    <system:String x:Key="ProcessGroup_View">视图</system:String>
    <system:String x:Key="ProcessGroup_Analysis">分析</system:String>
    <system:String x:Key="ProcessTab_Process">过程</system:String>

    <system:String x:Key="Process_ImageSource_Name">图像</system:String>
    <system:String x:Key="Process_ImageSource_Description">压缩文件、容器和不可变来源元数据。</system:String>
    <system:String x:Key="Process_Decoder_Name">解码器</system:String>
    <system:String x:Key="Process_Decoder_Description">解释图像二进制并创建 GPU 图像源；规范化可与首个消费过程融合。</system:String>
    <system:String x:Key="Process_ViewRendering_Name">视图渲染</system:String>
    <system:String x:Key="Process_ViewRendering_Description">将扩展 sRGB 线性中间图像映射到视图空间，并执行终端编码与提交。</system:String>
    <system:String x:Key="Process_GaussianBlur_Name">高斯模糊</system:String>
    <system:String x:Key="Process_GaussianBlur_Description">在 GPU 上直接卷积传入的纹理数值，不执行色彩空间转换。</system:String>
    <system:String x:Key="Process_ColorSpaceConversion_Name">色彩空间转换</system:String>
    <system:String x:Key="Process_ColorSpaceConversion_Description">显式指定输入/输出伽马和色域；相邻转换会融合执行，不交换过程元数据。</system:String>
    <system:String x:Key="Process_Waveform_Name">波形图</system:String>
    <system:String x:Key="Process_Waveform_Description">以亮度、RGB 分量分离或 RGB 分量叠合模式显示横向信号分布；振幅始终保持线性。</system:String>
    <system:String x:Key="Process_Histogram_Name">直方图</system:String>
    <system:String x:Key="Process_Histogram_Description">统计亮度或单一颜色通道的信号分布，可对振幅进行对数化显示。</system:String>
    <system:String x:Key="Process_Vectorscope_Name">矢量图</system:String>
    <system:String x:Key="Process_Vectorscope_Description">以色相着色显示色度分布，可对从中性点起算的辐长进行对数化显示。</system:String>
    <system:String x:Key="Process_StrictHistogram_Name">严格直方图</system:String>
    <system:String x:Key="Process_StrictHistogram_Description">使用 256 行超长竖幅显示亮度分布，每个亮度地址严格对应一行像素，可对振幅进行对数化显示。</system:String>

    <system:String x:Key="Parameter_DecoderBackend">解码后端</system:String>
    <system:String x:Key="Parameter_AllowFallback">允许后端回退</system:String>
    <system:String x:Key="Parameter_Frame">帧</system:String>
    <system:String x:Key="Parameter_ApplyExif">应用 EXIF 方向</system:String>
    <system:String x:Key="Parameter_AlphaMode">Alpha 处理</system:String>
    <system:String x:Key="Parameter_DecoderOutputTransfer">解码输出传递函数</system:String>
    <system:String x:Key="Parameter_DecoderOutputPrimaries">解码输出原色</system:String>
    <system:String x:Key="Parameter_DecoderOutputReferenceWhite">解码输出参考白</system:String>
    <system:String x:Key="Parameter_DecoderOutputPeak">解码输出标称峰值</system:String>
    <system:String x:Key="Parameter_Precision">精度</system:String>
    <system:String x:Key="Parameter_RenderPreset">映射预设</system:String>
    <system:String x:Key="Parameter_Interpolation">插值方法</system:String>
    <system:String x:Key="Parameter_BlurRadius">模糊半径</system:String>
    <system:String x:Key="Parameter_BlurSigma">标准差</system:String>
    <system:String x:Key="Parameter_InputGamma">输入伽马</system:String>
    <system:String x:Key="Parameter_InputGamut">输入色域</system:String>
    <system:String x:Key="Parameter_OutputGamma">输出伽马</system:String>
    <system:String x:Key="Parameter_OutputGamut">输出色域</system:String>
    <system:String x:Key="Parameter_SourcePeak">来源标称峰值</system:String>
    <system:String x:Key="Parameter_SourceReferenceWhite">来源参考白</system:String>
    <system:String x:Key="Parameter_SourceIsRelative">来源使用相对光</system:String>
    <system:String x:Key="Parameter_SdrWhite">SDR 白</system:String>
    <system:String x:Key="Parameter_TargetPeak">目标峰值</system:String>
    <system:String x:Key="Parameter_HlgOotf">HLG OOTF</system:String>
    <system:String x:Key="Parameter_GamutMapping">色域映射</system:String>
    <system:String x:Key="Parameter_UltraHdrReconstruct">Ultra HDR 重建</system:String>
    <system:String x:Key="Parameter_Background">背景与合成</system:String>
    <system:String x:Key="Parameter_WaveformMode">波形模式</system:String>
    <system:String x:Key="Parameter_HistogramChannel">统计通道</system:String>
    <system:String x:Key="Parameter_LogAmplitude">振幅对数化</system:String>
    <system:String x:Key="Parameter_LogRadius">辐长对数化</system:String>
    <system:String x:Key="Parameter_SampleRate">采样率</system:String>

    <system:String x:Key="Parameter_InputPrimaries">输入解释：原色</system:String>
    <system:String x:Key="Parameter_InputTransfer">输入解释：传递函数</system:String>
    <system:String x:Key="Parameter_InputPhotometric">输入解释：光度模型</system:String>
    <system:String x:Key="Parameter_InputReferenceWhite">输入解释：参考白</system:String>
    <system:String x:Key="Parameter_InputPeak">输入解释：峰值</system:String>
    <system:String x:Key="Parameter_InputRange">输入解释：范围</system:String>
    <system:String x:Key="Parameter_InputAlpha">输入解释：Alpha</system:String>
    <system:String x:Key="Parameter_OutputPrimaries">输出声明：原色</system:String>
    <system:String x:Key="Parameter_OutputTransfer">输出声明：传递函数</system:String>
    <system:String x:Key="Parameter_OutputPhotometric">输出声明：光度模型</system:String>
    <system:String x:Key="Parameter_OutputReferenceWhite">输出声明：参考白</system:String>
    <system:String x:Key="Parameter_OutputPeak">输出声明：峰值</system:String>
    <system:String x:Key="Parameter_OutputRange">输出声明：范围</system:String>
    <system:String x:Key="Parameter_OutputAlpha">输出声明：Alpha</system:String>

</ResourceDictionary>
