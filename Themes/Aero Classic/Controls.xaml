<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aero Brushes -->
    <LinearGradientBrush x:Key="AeroBlueGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF2FA" Offset="0"/>
        <GradientStop Color="#E9F1F9" Offset="0.3"/>
        <GradientStop Color="#D2E4F5" Offset="0.7"/>
        <GradientStop Color="#C7DDF0" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AeroBorderBrush" Color="#A5C9E6"/>
    <SolidColorBrush x:Key="AeroDisabledBorderBrush" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="AeroDisabledBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="AeroTextBrush" Color="#1E395B"/>
    <SolidColorBrush x:Key="AeroDisabledTextBrush" Color="#888888"/>

    <!-- Bureau-style neutral chrome. Blue is reserved for selection and active actions. -->
    <LinearGradientBrush x:Key="BureauHeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FEFEFE" Offset="0"/>
        <GradientStop Color="#F8F8F8" Offset="0.38"/>
        <GradientStop Color="#ECEDEF" Offset="0.48"/>
        <GradientStop Color="#DEE0E2" Offset="0.52"/>
        <GradientStop Color="#CED2D5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BureauStatusBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFAFA" Offset="0"/>
        <GradientStop Color="#E9EAEB" Offset="0.5"/>
        <GradientStop Color="#D7DADD" Offset="1"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="BureauHeaderTextureBrush" TileMode="Tile"
                  Viewport="0,0,4,4" ViewportUnits="Absolute"
                  Viewbox="0,0,4,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#18FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#08000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,3,4,1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="BureauHeaderBorderBrush" Color="#8E969D"/>
    <SolidColorBrush x:Key="BureauHeaderSeparatorBrush" Color="#B2B7BC"/>
    <SolidColorBrush x:Key="BureauHeaderTextBrush" Color="#2E3338"/>

    <!-- Button Brushes -->
    <LinearGradientBrush x:Key="AeroButtonNormalBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0F9FF" Offset="0"/>
        <GradientStop Color="#D7E8F9" Offset="0.5"/>
        <GradientStop Color="#BDE0F8" Offset="0.5"/>
        <GradientStop Color="#B6D8F4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AeroButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFCEE" Offset="0"/>
        <GradientStop Color="#FFE294" Offset="0.5"/>
        <GradientStop Color="#FFD97D" Offset="0.5"/>
        <GradientStop Color="#FFD46A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AeroButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2E4A7" Offset="0"/>
        <GradientStop Color="#F0D773" Offset="0.5"/>
        <GradientStop Color="#EBCF61" Offset="0.5"/>
        <GradientStop Color="#E9C95C" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AeroButtonNormalBorderBrush" Color="#83B3D3"/>
    <SolidColorBrush x:Key="AeroButtonHoverBorderBrush" Color="#E5C365"/>
    <SolidColorBrush x:Key="AeroButtonPressedBorderBrush" Color="#9B813C"/>

    <LinearGradientBrush x:Key="AeroButtonHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="Transparent" Offset="1.0" />
    </LinearGradientBrush>

    <!-- GroupBox Style -->
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource AeroBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="true">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Border Grid.Row="0" Background="{DynamicResource AeroBlueGradientBrush}" BorderBrush="{DynamicResource AeroBorderBrush}" BorderThickness="1" CornerRadius="2,2,0,0" >
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,2,5,2"/>
                        </Border>
                        <!-- Content -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource AeroBorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,2,2" Padding="5">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
