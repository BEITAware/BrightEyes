<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:contracts="clr-namespace:BrightEyes.Processing.Contracts"
                    xmlns:viewModels="clr-namespace:BrightEyes.ViewModels">

    <SolidColorBrush x:Key="ProcessSurfaceBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="ProcessSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4FAFE" Offset="0" />
        <GradientStop Color="#E2F0FA" Offset="0.5" />
        <GradientStop Color="#D4E9F7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProcessBorderBrush" Color="#B8C5CE" />
    <SolidColorBrush x:Key="ProcessDisabledBrush" Color="#E7E9EC" />
    <SolidColorBrush x:Key="ProcessTextBrush" Color="#172B3A" />
    <SolidColorBrush x:Key="ProcessMutedTextBrush" Color="#526675" />
    <LinearGradientBrush x:Key="ProcessDropSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F1FAFF" Offset="0.38" />
        <GradientStop Color="#D7EEFC" Offset="0.48" />
        <GradientStop Color="#B9DFF7" Offset="0.52" />
        <GradientStop Color="#9DCEED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessDropWarningSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDF5" Offset="0" />
        <GradientStop Color="#FFF8DD" Offset="0.38" />
        <GradientStop Color="#FCE9B4" Offset="0.48" />
        <GradientStop Color="#F6D57D" Offset="0.52" />
        <GradientStop Color="#E8B94F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessDropAreaAllowedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F9FCFE" Offset="0" />
        <GradientStop Color="#E5F2FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessDropAreaWarningBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFCF4" Offset="0" />
        <GradientStop Color="#FBECCB" Offset="1" />
    </LinearGradientBrush>
    <!-- Narrow type lanes use a lateral metallic highlight so they still read as
         Bureau chrome instead of a flat category stripe. -->
    <LinearGradientBrush x:Key="RawConnectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#08758A" Offset="0" />
        <GradientStop Color="#C6FBFF" Offset="0.24" />
        <GradientStop Color="#36C5D6" Offset="0.42" />
        <GradientStop Color="#159BB4" Offset="0.74" />
        <GradientStop Color="#075F75" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IntermediateConnectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#44358B" Offset="0" />
        <GradientStop Color="#E1DDFF" Offset="0.24" />
        <GradientStop Color="#9384E4" Offset="0.42" />
        <GradientStop Color="#6654BC" Offset="0.74" />
        <GradientStop Color="#3C2E83" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RawConnectionBorderBrush" Color="#087087" />
    <SolidColorBrush x:Key="IntermediateConnectionBorderBrush" Color="#50419A" />
    <SolidColorBrush x:Key="RawConnectionTextBrush" Color="#145B69" />
    <SolidColorBrush x:Key="IntermediateConnectionTextBrush" Color="#544A7A" />
    <LinearGradientBrush x:Key="RawConnectionLabelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBFFFF" Offset="0" />
        <GradientStop Color="#E9FAFC" Offset="0.46" />
        <GradientStop Color="#C2EAF0" Offset="0.5" />
        <GradientStop Color="#E0F5F7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IntermediateConnectionLabelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FEFDFF" Offset="0" />
        <GradientStop Color="#F1EEFC" Offset="0.46" />
        <GradientStop Color="#D2CCEC" Offset="0.5" />
        <GradientStop Color="#E8E4F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ErrorConnectionLaneBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C1724" Offset="0" />
        <GradientStop Color="#FFD4D8" Offset="0.24" />
        <GradientStop Color="#E45B67" Offset="0.42" />
        <GradientStop Color="#B72C3B" Offset="0.76" />
        <GradientStop Color="#721522" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ErrorConnectionLabelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDFD" Offset="0" />
        <GradientStop Color="#FDEBED" Offset="0.46" />
        <GradientStop Color="#EFC3C8" Offset="0.5" />
        <GradientStop Color="#F8E1E4" Offset="1" />
    </LinearGradientBrush>

    <!-- Glossy badge faces share the same split highlight used by classic Aero
         command surfaces, while semantic state is carried by restrained tint. -->
    <LinearGradientBrush x:Key="ProcessStatusColumnBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFCFD" Offset="0" />
        <GradientStop Color="#EEF2F5" Offset="0.48" />
        <GradientStop Color="#DCE2E7" Offset="0.52" />
        <GradientStop Color="#EFF2F4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessGripColumnBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E7EDF1" Offset="0" />
        <GradientStop Color="#FAFCFD" Offset="0.42" />
        <GradientStop Color="#DDE4E9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessBadgeNeutralBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F2F5F7" Offset="0.46" />
        <GradientStop Color="#CCD4DA" Offset="0.5" />
        <GradientStop Color="#E5EAED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessBadgeBlueBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#EAF6FE" Offset="0.46" />
        <GradientStop Color="#AFCFE7" Offset="0.5" />
        <GradientStop Color="#D5EAF7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessBadgeGreenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#EDF9E8" Offset="0.46" />
        <GradientStop Color="#B5D99D" Offset="0.5" />
        <GradientStop Color="#DBEFCB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessBadgeAmberBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FFF8DF" Offset="0.46" />
        <GradientStop Color="#E8C470" Offset="0.5" />
        <GradientStop Color="#F8E7B1" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessBadgeRedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FDEDEF" Offset="0.46" />
        <GradientStop Color="#E6A1A9" Offset="0.5" />
        <GradientStop Color="#F5CDD2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProcessBadgeHighlightBrush" Color="#CFFFFFFF" />
    <SolidColorBrush x:Key="ProcessBadgeNeutralBorderBrush" Color="#98A6B0" />
    <SolidColorBrush x:Key="ProcessBadgeBlueBorderBrush" Color="#73A6C9" />
    <SolidColorBrush x:Key="ProcessBadgeGreenBorderBrush" Color="#78A75C" />
    <SolidColorBrush x:Key="ProcessBadgeAmberBorderBrush" Color="#B18732" />
    <SolidColorBrush x:Key="ProcessBadgeRedBorderBrush" Color="#B85B66" />
    <SolidColorBrush x:Key="WarningConnectionBrush" Color="#D97818" />
    <SolidColorBrush x:Key="ErrorConnectionBrush" Color="#C43E4B" />

    <Style TargetType="{x:Type ListBoxItem}" x:Key="ProcessListItemStyle">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <ContentPresenter />
                        <Border x:Name="DropBefore" Height="56" Margin="3,2,3,0" Panel.ZIndex="2"
                                VerticalAlignment="Top" Background="{DynamicResource ProcessDropSurfaceBrush}"
                                BorderBrush="#3C7FB1" BorderThickness="1" CornerRadius="2" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Margin="1" BorderBrush="#D9FFFFFF"
                                        BorderThickness="1,1,1,0" CornerRadius="1" IsHitTestVisible="False" />
                                <Border x:Name="DropBeforeIcon" Grid.Column="0" Width="22" Height="22"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#66FFFFFF" BorderBrush="#8BB9D7" BorderThickness="1" CornerRadius="1">
                                    <TextBlock x:Name="DropBeforeArrow" Text="&#x25BC;" FontSize="11" Foreground="#185B8B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="DropBeforeText" Grid.Column="1" Text="在这里放下" Margin="8,0,12,0" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#174E75" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="DropAfter" Height="56" Margin="3,0,3,2" Panel.ZIndex="2"
                                VerticalAlignment="Bottom" Background="{DynamicResource ProcessDropSurfaceBrush}"
                                BorderBrush="#3C7FB1" BorderThickness="1" CornerRadius="2" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Margin="1" BorderBrush="#D9FFFFFF"
                                        BorderThickness="1,1,1,0" CornerRadius="1" IsHitTestVisible="False" />
                                <Border x:Name="DropAfterIcon" Grid.Column="0" Width="22" Height="22"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#66FFFFFF" BorderBrush="#8BB9D7" BorderThickness="1" CornerRadius="1">
                                    <TextBlock x:Name="DropAfterArrow" Text="&#x25BC;" FontSize="11" Foreground="#185B8B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="DropAfterText" Grid.Column="1" Text="在这里放下" Margin="8,0,12,0" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#174E75" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="DropTargetBefore">
                            <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="DropTargetAfter">
                            <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="DropTargetBeforeWarning">
                            <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DropBefore" Property="Background" Value="{StaticResource ProcessDropWarningSurfaceBrush}" />
                            <Setter TargetName="DropBefore" Property="BorderBrush" Value="#A86D12" />
                            <Setter TargetName="DropBeforeIcon" Property="BorderBrush" Value="#C28A32" />
                            <Setter TargetName="DropBeforeArrow" Property="Foreground" Value="#84510A" />
                            <Setter TargetName="DropBeforeText" Property="Foreground" Value="#6D4308" />
                        </Trigger>
                        <Trigger Property="Tag" Value="DropTargetAfterWarning">
                            <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DropAfter" Property="Background" Value="{StaticResource ProcessDropWarningSurfaceBrush}" />
                            <Setter TargetName="DropAfter" Property="BorderBrush" Value="#A86D12" />
                            <Setter TargetName="DropAfterIcon" Property="BorderBrush" Value="#C28A32" />
                            <Setter TargetName="DropAfterArrow" Property="Foreground" Value="#84510A" />
                            <Setter TargetName="DropAfterText" Property="Foreground" Value="#6D4308" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Descriptor.Definition.CanMove}" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Descriptor.Definition.CanDelete}" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ProcessItemTemplate">
        <Border x:Name="ProcessBlock" MinHeight="60" Background="{DynamicResource ProcessSurfaceBrush}"
                BorderBrush="{DynamicResource ProcessBorderBrush}" BorderThickness="0,0,0,1"
                ToolTip="{Binding Diagnostic}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除" Command="{Binding PlacementTarget.Tag.DeleteProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="启用/禁用" Command="{Binding PlacementTarget.Tag.ToggleProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="重置参数" Command="{Binding PlacementTarget.Tag.ResetProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="恢复自动值" Command="{Binding PlacementTarget.Tag.RestoreAutomaticCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="查看输入元数据" Command="{Binding PlacementTarget.Tag.InspectInputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="查看输出元数据" Command="{Binding PlacementTarget.Tag.InspectOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="复制参数" Command="{Binding PlacementTarget.Tag.CopyParametersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="粘贴参数" Command="{Binding PlacementTarget.Tag.PasteParametersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ConnectionLane" Background="{DynamicResource IntermediateConnectionBorderBrush}"
                        BorderBrush="{DynamicResource IntermediateConnectionBorderBrush}" BorderThickness="0,0,1,0"
                        ToolTip="{Binding IncomingConnectionMessage}">
                    <Grid>
                        <Border x:Name="ConnectionLine" Margin="0,1,1,1"
                                Background="{DynamicResource IntermediateConnectionBrush}" />
                        <Border Margin="1,2,2,2" BorderBrush="#9FFFFFFF"
                                BorderThickness="1,1,0,0" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource ProcessGripColumnBrush}"
                        BorderBrush="#C0CAD1" BorderThickness="0,0,1,0"
                        ToolTip="按住整行即可拖动">
                    <TextBlock Text="&#x2261;" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="17" Foreground="#657684" />
                </Border>

                <Grid Grid.Column="2" Margin="6,4,7,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Margin="0,0,5,0"
                               Source="{Binding Descriptor.Definition.IconResourceKey, Converter={StaticResource ResourceLookupConverter}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Descriptor.Definition.NameResourceKey, Converter={StaticResource ResourceLookupConverter}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ProcessTextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,2,0,1" FontSize="10"
                               Foreground="{DynamicResource ProcessMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="9" Foreground="#405467" TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}  &gt;  {1}">
                                    <Binding Path="Descriptor.Definition.InputType" />
                                    <Binding Path="Descriptor.Definition.OutputType" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Border x:Name="ConnectionLabel" Grid.Column="1" Margin="6,0,0,0" Padding="1"
                                Background="{DynamicResource IntermediateConnectionLabelBrush}"
                                BorderBrush="{DynamicResource IntermediateConnectionBorderBrush}"
                                BorderThickness="1" CornerRadius="1">
                            <Grid>
                                <Border BorderBrush="{DynamicResource ProcessBadgeHighlightBrush}"
                                        BorderThickness="1,1,1,0" CornerRadius="1" IsHitTestVisible="False" />
                                <TextBlock x:Name="ConnectionLabelText" Text="{Binding IncomingConnectionLabel}"
                                           Margin="3,-1,3,0" FontSize="9"
                                           Foreground="{DynamicResource IntermediateConnectionTextBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="3" Background="{DynamicResource ProcessStatusColumnBrush}"
                        BorderBrush="#C0CAD1" BorderThickness="1,0,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="StateBadge" Padding="1" Background="{DynamicResource ProcessBadgeNeutralBrush}"
                                BorderBrush="{DynamicResource ProcessBadgeNeutralBorderBrush}"
                                BorderThickness="1" CornerRadius="1">
                            <Grid>
                                <Border BorderBrush="{DynamicResource ProcessBadgeHighlightBrush}"
                                        BorderThickness="1,1,1,0" CornerRadius="1" IsHitTestVisible="False" />
                                <TextBlock x:Name="StateBadgeText" Text="{Binding State}" Margin="3,0"
                                           FontSize="9" Foreground="{DynamicResource ProcessTextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="54" />
                            </Grid>
                        </Border>
                        <Border x:Name="OverrideBadge" Margin="0,3,0,0" Padding="1"
                                HorizontalAlignment="Center" Background="{DynamicResource ProcessBadgeAmberBrush}"
                                BorderBrush="{DynamicResource ProcessBadgeAmberBorderBrush}"
                                BorderThickness="1" CornerRadius="1" Visibility="Collapsed">
                            <Grid>
                                <Border BorderBrush="{DynamicResource ProcessBadgeHighlightBrush}"
                                        BorderThickness="1,1,1,0" CornerRadius="1" IsHitTestVisible="False" />
                                <TextBlock Text="手动" Margin="3,-1,3,0" FontSize="9" Foreground="#754306" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="WarningOverlay" Text="! 检查" Margin="0,3,0,0" HorizontalAlignment="Center"
                                   FontSize="9" FontWeight="Bold" Foreground="#A9580B" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Descriptor.Definition.InputType}" Value="RawImage">
                <Setter TargetName="ConnectionLine" Property="Background" Value="{DynamicResource RawConnectionBrush}" />
                <Setter TargetName="ConnectionLane" Property="Background" Value="{DynamicResource RawConnectionBorderBrush}" />
                <Setter TargetName="ConnectionLane" Property="BorderBrush" Value="{DynamicResource RawConnectionBorderBrush}" />
                <Setter TargetName="ConnectionLabel" Property="BorderBrush" Value="{DynamicResource RawConnectionBorderBrush}" />
                <Setter TargetName="ConnectionLabel" Property="Background" Value="{DynamicResource RawConnectionLabelBrush}" />
                <Setter TargetName="ConnectionLabelText" Property="Foreground" Value="{DynamicResource RawConnectionTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IncomingConnectionSeverity}" Value="None">
                <Setter TargetName="ConnectionLane" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ConnectionLabel" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IncomingConnectionSeverity}" Value="SemanticWarning">
                <Setter TargetName="WarningOverlay" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IncomingConnectionSeverity}" Value="HardError">
                <Setter TargetName="ConnectionLine" Property="Background" Value="{StaticResource ErrorConnectionLaneBrush}" />
                <Setter TargetName="ConnectionLane" Property="Background" Value="{StaticResource ErrorConnectionBrush}" />
                <Setter TargetName="ConnectionLabel" Property="BorderBrush" Value="{StaticResource ErrorConnectionBrush}" />
                <Setter TargetName="ConnectionLabel" Property="Background" Value="{StaticResource ErrorConnectionLabelBrush}" />
                <Setter TargetName="ConnectionLabelText" Property="Foreground" Value="{StaticResource ErrorConnectionBrush}" />
                <Setter TargetName="ProcessBlock" Property="BorderBrush" Value="{StaticResource ErrorConnectionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Pending">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ProcessBadgeBlueBrush}" />
                <Setter TargetName="StateBadge" Property="BorderBrush" Value="{DynamicResource ProcessBadgeBlueBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ProcessBadgeBlueBrush}" />
                <Setter TargetName="StateBadge" Property="BorderBrush" Value="{DynamicResource ProcessBadgeBlueBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Cached">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ProcessBadgeBlueBrush}" />
                <Setter TargetName="StateBadge" Property="BorderBrush" Value="{DynamicResource ProcessBadgeBlueBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Valid">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ProcessBadgeGreenBrush}" />
                <Setter TargetName="StateBadge" Property="BorderBrush" Value="{DynamicResource ProcessBadgeGreenBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Warning">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ProcessBadgeAmberBrush}" />
                <Setter TargetName="StateBadge" Property="BorderBrush" Value="{DynamicResource ProcessBadgeAmberBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Stale">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ProcessBadgeAmberBrush}" />
                <Setter TargetName="StateBadge" Property="BorderBrush" Value="{DynamicResource ProcessBadgeAmberBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ProcessBadgeRedBrush}" />
                <Setter TargetName="StateBadge" Property="BorderBrush" Value="{DynamicResource ProcessBadgeRedBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasUserOverrides}" Value="True">
                <Setter TargetName="OverrideBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="ProcessBlock" Property="Background" Value="{DynamicResource ProcessDisabledBrush}" />
                <Setter TargetName="ProcessBlock" Property="Opacity" Value="0.68" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="ProcessBlock" Property="BorderBrush" Value="#6EA6D1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="ProcessBlock" Property="Background" Value="{DynamicResource ProcessSelectedBrush}" />
                <Setter TargetName="ProcessBlock" Property="BorderBrush" Value="#2B79B8" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="NumberParameterTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}"
                    IsSnapToTickEnabled="False" Value="{Binding NumberValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="EnumParameterTemplate">
        <ComboBox ItemsSource="{Binding EnumValues}" SelectedItem="{Binding SelectedEnumValue, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="BooleanParameterTemplate">
        <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}" Content="启用" />
    </DataTemplate>

    <DataTemplate x:Key="TextParameterTemplate">
        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:ProcessParameterViewModel}">
        <Border BorderBrush="#D8E1E8" BorderThickness="0,0,0,1" Padding="3,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ProcessTextBrush}" TextWrapping="Wrap" />
                    <CheckBox Grid.Column="1" Content="自动" Margin="8,0,0,0" IsChecked="{Binding IsAutomatic, Mode=TwoWay}" />
                </Grid>
                <ContentControl x:Name="Editor" Content="{Binding}" Margin="0,6,0,0" ContentTemplate="{StaticResource TextParameterTemplate}" />
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="检测" FontSize="10" Foreground="{DynamicResource ProcessMutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding DetectedText}" FontSize="10" Margin="8,0,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="自动" FontSize="10" Foreground="{DynamicResource ProcessMutedTextBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AutomaticText}" FontSize="10" Margin="8,0,0,0" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{Binding AutomaticSource, StringFormat=来源：{0}}" FontSize="10" Foreground="{DynamicResource ProcessMutedTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ValidationError}" FontSize="10" Foreground="{StaticResource ErrorConnectionBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Editor}" Value="Number">
                <Setter TargetName="Editor" Property="ContentTemplate" Value="{StaticResource NumberParameterTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Editor}" Value="Enum">
                <Setter TargetName="Editor" Property="ContentTemplate" Value="{StaticResource EnumParameterTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Editor}" Value="Boolean">
                <Setter TargetName="Editor" Property="ContentTemplate" Value="{StaticResource BooleanParameterTemplate}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type contracts:MetadataFact}">
        <Grid Margin="3,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ProcessMutedTextBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{Binding Source, StringFormat={}{0}}" TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource ProcessMutedTextBrush}" />
                <TextBlock Text="{Binding Conflict}" TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource WarningConnectionBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
