<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bureau White keeps Bureau Blue's relief and scan-line texture, but removes
         chroma from passive chrome. Blue is reserved for active interaction. -->
    <Color x:Key="BureauWhiteAccentColor">#2B78B8</Color>

    <LinearGradientBrush x:Key="AeroBlueGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F2F2" Offset="0" />
        <GradientStop Color="#F0F0F0" Offset="0.3" />
        <GradientStop Color="#E2E2E2" Offset="0.7" />
        <GradientStop Color="#D9D9D9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AeroBorderBrush" Color="#C2C2C2" />
    <SolidColorBrush x:Key="AeroDisabledBorderBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="AeroDisabledBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="AeroTextBrush" Color="#363636" />
    <SolidColorBrush x:Key="AeroDisabledTextBrush" Color="#888888" />

    <LinearGradientBrush x:Key="BureauHeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FEFEFE" Offset="0" />
        <GradientStop Color="#F8F8F8" Offset="0.38" />
        <GradientStop Color="#EDEDED" Offset="0.48" />
        <GradientStop Color="#DFDFDF" Offset="0.52" />
        <GradientStop Color="#D1D1D1" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BureauStatusBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFAFA" Offset="0" />
        <GradientStop Color="#EAEAEA" Offset="0.5" />
        <GradientStop Color="#D9D9D9" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="BureauHeaderTextureBrush" TileMode="Tile"
                  Viewport="0,0,4,4" ViewportUnits="Absolute"
                  Viewbox="0,0,4,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#18FFFFFF" Geometry="M0,0 H4 V1 H0 Z" />
                <GeometryDrawing Brush="#08000000" Geometry="M0,3 H4 V4 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="BureauHeaderBorderBrush" Color="#929292" />
    <SolidColorBrush x:Key="BureauHeaderSeparatorBrush" Color="#B6B6B6" />
    <SolidColorBrush x:Key="BureauHeaderTextBrush" Color="#333333" />

    <LinearGradientBrush x:Key="AeroButtonNormalBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8F8F8" Offset="0" />
        <GradientStop Color="#E8E8E8" Offset="0.5" />
        <GradientStop Color="#DADADA" Offset="0.5" />
        <GradientStop Color="#D3D3D3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AeroButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FAFE" Offset="0" />
        <GradientStop Color="#DDECF8" Offset="0.5" />
        <GradientStop Color="#C9E1F3" Offset="0.5" />
        <GradientStop Color="#B8D7EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AeroButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D7E8F5" Offset="0" />
        <GradientStop Color="#B9D8EE" Offset="0.5" />
        <GradientStop Color="#A6CCE8" Offset="0.5" />
        <GradientStop Color="#91BEDF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AeroButtonNormalBorderBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="AeroButtonHoverBorderBrush" Color="#4F8FBE" />
    <SolidColorBrush x:Key="AeroButtonPressedBorderBrush" Color="#286A9D" />

    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="DocumentBarBackgroundBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="ApplicationChromeBorderBrush" Color="#CBCBCB" />
    <SolidColorBrush x:Key="ApplicationMutedTextBrush" Color="#626262" />
    <SolidColorBrush x:Key="InspectorDividerBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="AnalysisBorderBrush" Color="#C2C2C2" />
    <SolidColorBrush x:Key="WorkspaceSplitterBrush" Color="#D2D2D2" />
    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="HighlightEdgeBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PipelineSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PipelineSurfaceBorderBrush" Color="#A7A7A7" />
    <SolidColorBrush x:Key="PipelineAllowedBorderBrush" Color="{StaticResource BureauWhiteAccentColor}" />
    <SolidColorBrush x:Key="PipelineDeniedSurfaceBrush" Color="#FFF1F1" />
    <SolidColorBrush x:Key="PipelineDeniedBorderBrush" Color="#B84A4A" />
    <SolidColorBrush x:Key="PipelineWarningBorderBrush" Color="#C48118" />
    <SolidColorBrush x:Key="PipelinePlaceholderTextBrush" Color="#888888" />
    <SolidColorBrush x:Key="PipelineStatusBorderBrush" Color="#A7A7A7" />
    <SolidColorBrush x:Key="PipelineStatusTextBrush" Color="#505050" />
    <SolidColorBrush x:Key="ApplicationPrimaryTextBrush" Color="#292929" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#E7E7E7" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#484848" />

    <SolidColorBrush x:Key="ProcessSurfaceBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="ProcessSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FAFE" Offset="0" />
        <GradientStop Color="#E2F0FA" Offset="0.5" />
        <GradientStop Color="#D1E7F6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProcessBorderBrush" Color="#C1C1C1" />
    <SolidColorBrush x:Key="ProcessDisabledBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="ProcessTextBrush" Color="#292929" />
    <SolidColorBrush x:Key="ProcessMutedTextBrush" Color="#626262" />
    <LinearGradientBrush x:Key="ProcessDropSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F6F6F6" Offset="0.38" />
        <GradientStop Color="#E9E9E9" Offset="0.48" />
        <GradientStop Color="#DADADA" Offset="0.52" />
        <GradientStop Color="#CACACA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProcessDropAreaAllowedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFCFE" Offset="0" />
        <GradientStop Color="#E2EFF8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RawConnectionBrush" Color="#2B87A2" />
    <SolidColorBrush x:Key="IntermediateConnectionBrush" Color="{StaticResource BureauWhiteAccentColor}" />
</ResourceDictionary>
