<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Luna.NormalColor remains the implicit base for standard controls. These
         few application-level surfaces add the chunkier molded-plastic language. -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource ApplicationPrimaryTextBrush}" />
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource ApplicationPrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="1" Margin="0,-1,0,0"
                                Background="{DynamicResource LunaPanelSurfaceBrush}"
                                BorderBrush="{DynamicResource AeroBorderBrush}"
                                BorderThickness="2" CornerRadius="0,0,9,9">
                            <Grid>
                                <Border Margin="2" BorderBrush="#9CFFFFFF" BorderThickness="1"
                                        CornerRadius="0,0,6,6" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" MinHeight="27"
                                Background="{DynamicResource LunaBluePlasticBrush}"
                                BorderBrush="#0B429C" BorderThickness="2"
                                CornerRadius="9,9,3,3">
                            <Grid>
                                <Border Margin="2" BorderBrush="#AFFFFFFF" BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,2,2" IsHitTestVisible="False" />
                                <Ellipse Width="8" Height="8" Margin="8,0,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource LunaGreenPlasticBrush}"
                                         Stroke="#FFFFFF" StrokeThickness="1" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  Margin="21,4,9,5" VerticalAlignment="Center"
                                                  TextElement.Foreground="#FFFFFF"
                                                  TextElement.FontWeight="Bold" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="Foreground" Value="#183A62" />
        <Setter Property="Background" Value="#F8FFD9" />
        <Setter Property="BorderBrush" Value="#4B8A17" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="#68A7D2" />
    </Style>
</ResourceDictionary>
