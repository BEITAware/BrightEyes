<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- The platform Luna dictionary is deliberately first: every standard WPF
             control not redrawn by BrightEyes retains the Windows XP appearance. -->
        <ResourceDictionary Source="/PresentationFramework.Luna;component/themes/Luna.NormalColor.xaml" />

        <!-- The pipeline is an application-specific control surface and therefore
             has no platform fallback. Reuse its behavior/template, then recolor it
             through Luna's dynamic palette. -->
        <ResourceDictionary Source="../Aero Classic/ProcessPipeline.xaml" />
        <ResourceDictionary Source="Palette.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
        <ResourceDictionary Source="Ribbon.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
