<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:r="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon">
    <LinearGradientBrush x:Key="LunaRibbonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D7FAFF" Offset="0" />
        <GradientStop Color="#6DD2EF" Offset="0.25" />
        <GradientStop Color="#167CD5" Offset="0.47" />
        <GradientStop Color="#0A4FBC" Offset="0.5" />
        <GradientStop Color="#46B4EA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LunaRibbonGroupBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F9FEFF" Offset="0" />
        <GradientStop Color="#E4F7FF" Offset="0.56" />
        <GradientStop Color="#C8DFF5" Offset="0.68" />
        <GradientStop Color="#E8E4FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LunaRibbonTabNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C9FAFF" Offset="0" />
        <GradientStop Color="#48C8F2" Offset="0.2" />
        <GradientStop Color="#1588DC" Offset="0.48" />
        <GradientStop Color="#0752B8" Offset="0.52" />
        <GradientStop Color="#2EA8EB" Offset="0.86" />
        <GradientStop Color="#0960C5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LunaRibbonTabHotBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFE4" Offset="0" />
        <GradientStop Color="#FFF18B" Offset="0.43" />
        <GradientStop Color="#F5A126" Offset="0.49" />
        <GradientStop Color="#FFCA56" Offset="0.82" />
        <GradientStop Color="#E9830D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LunaRibbonTabSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E9FCFF" Offset="0.35" />
        <GradientStop Color="#9BE8F7" Offset="0.49" />
        <GradientStop Color="#41B8E4" Offset="0.53" />
        <GradientStop Color="#B8F1FA" Offset="0.78" />
        <GradientStop Color="#E7FBFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LunaRibbonTabSelectionStripeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2B7C08" Offset="0" />
        <GradientStop Color="#B9F35C" Offset="0.18" />
        <GradientStop Color="#62B718" Offset="0.5" />
        <GradientStop Color="#C9FA70" Offset="0.82" />
        <GradientStop Color="#347F0B" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="{x:Type r:Ribbon}">
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{StaticResource LunaRibbonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#083D9D" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style TargetType="{x:Type r:RibbonTab}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#0A4BA8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#173E68" />
                <Setter Property="Background" Value="{StaticResource LunaRibbonTabHotBrush}" />
                <Setter Property="BorderBrush" Value="#B85D00" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#0A3564" />
                <Setter Property="Background" Value="{StaticResource LunaRibbonTabSelectedBrush}" />
                <Setter Property="BorderBrush" Value="#073D9B" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- RibbonTab renders its caption through a separate header container.  The
         molded, high-gloss template deliberately echoes XP taskbar buttons and
         the thick blue plastic used elsewhere in the Luna theme. -->
    <Style TargetType="{x:Type r:RibbonTabHeader}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="Background" Value="{StaticResource LunaRibbonTabNormalBrush}" />
        <Setter Property="BorderBrush" Value="#063A91" />
        <Setter Property="MouseOverBackground" Value="{StaticResource LunaRibbonTabHotBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="#B85D00" />
        <Setter Property="CheckedBackground" Value="{StaticResource LunaRibbonTabSelectedBrush}" />
        <Setter Property="CheckedBorderBrush" Value="#073D9B" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Padding" Value="16,5,16,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type r:RibbonTabHeader}">
                    <Grid x:Name="LayoutRoot" Margin="1,2,0,0" SnapsToDevicePixels="True">
                        <Border x:Name="Shadow"
                                Margin="2,2,-1,-1"
                                Background="#70002D72"
                                BorderBrush="#7045C8F2"
                                BorderThickness="1"
                                CornerRadius="8,8,2,2" />
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8,8,2,2">
                            <Grid ClipToBounds="True">
                                <Border x:Name="SpecularHighlight"
                                        Height="9" Margin="2,2,2,0"
                                        VerticalAlignment="Top"
                                        Background="#52FFFFFF"
                                        BorderBrush="#B8FFFFFF"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,2,2"
                                        IsHitTestVisible="False" />
                                <Border x:Name="SelectionStripe"
                                        Height="3" Margin="2,0,2,1"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource LunaRibbonTabSelectionStripeBrush}"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LunaRibbonTabHotBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#B85D00" />
                            <Setter TargetName="Shadow" Property="Background" Value="#70A74C00" />
                            <Setter Property="Foreground" Value="#633000" />
                            <Setter Property="TextElement.Foreground" Value="#633000" />
                        </Trigger>
                        <Trigger Property="IsRibbonTabSelected" Value="True">
                            <Setter TargetName="LayoutRoot" Property="Margin" Value="1,0,0,-1" />
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LunaRibbonTabSelectedBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#073D9B" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectionStripe" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="#0A3564" />
                            <Setter Property="TextElement.Foreground" Value="#0A3564" />
                            <Setter Property="Panel.ZIndex" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.58" />
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="#B9CDE1" />
                            <Setter Property="TextElement.Foreground" Value="#B9CDE1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsRibbonTabSelected" Value="True">
                <Setter Property="Foreground" Value="#0A3564" />
                <Setter Property="TextElement.Foreground" Value="#0A3564" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type r:RibbonGroup}">
        <Setter Property="Foreground" Value="#173B65" />
        <Setter Property="Background" Value="{StaticResource LunaRibbonGroupBrush}" />
        <Setter Property="BorderBrush" Value="#2874BB" />
    </Style>

    <Style TargetType="{x:Type r:RibbonButton}">
        <Setter Property="Foreground" Value="#15375E" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AeroButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AeroButtonHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AeroButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AeroButtonPressedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#4C6276" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
