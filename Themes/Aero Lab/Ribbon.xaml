<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:r="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon">
    <LinearGradientBrush x:Key="BureauWhiteRibbonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F7F7F7" Offset="0.34" />
        <GradientStop Color="#ECECEC" Offset="0.35" />
        <GradientStop Color="#DEDEDE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BureauWhiteRibbonGroupBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FCFCFC" Offset="0" />
        <GradientStop Color="#F1F1F1" Offset="0.72" />
        <GradientStop Color="#E2E2E2" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="{x:Type r:Ribbon}">
        <Setter Property="Background" Value="{StaticResource BureauWhiteRibbonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#A4A4A4" />
        <Setter Property="Foreground" Value="#2D2D2D" />
    </Style>
    <Style TargetType="{x:Type r:RibbonTab}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#A8A8A8" />
        <Setter Property="Foreground" Value="#303030" />
    </Style>
    <Style TargetType="{x:Type r:RibbonGroup}">
        <Setter Property="Background" Value="{StaticResource BureauWhiteRibbonGroupBrush}" />
        <Setter Property="BorderBrush" Value="#B6B6B6" />
        <Setter Property="Foreground" Value="#404040" />
    </Style>
    <Style TargetType="{x:Type r:RibbonButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#303030" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AeroButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AeroButtonHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AeroButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AeroButtonPressedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#888888" />
                <Setter Property="Opacity" Value="0.72" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
